TARGET = sailvless

CONFIG += sailfishapp sailfishapp_i18n
QT += dbus

isEmpty(VERSION): VERSION = 1.0.9
DEFINES += APP_VERSION=\\\"$$VERSION\\\"

SOURCES += \
    src/main.cpp \
    src/daemon.cpp

HEADERS += \
    src/daemon.h

DISTFILES += \
    qml/*.qml \
    qml/pages/*.qml \
    qml/cover/*.qml \
    qml/js/*.js \
    sailvless.desktop

SAILFISHAPP_ICONS = 86x86 108x108 128x128 172x172

# generated by translations/gen-ts.ps1: sailvless.ts holds the English plural forms
TRANSLATIONS += \
    translations/sailvless.ts \
    translations/sailvless-ru.ts \
    translations/sailvless-zh_CN.ts
