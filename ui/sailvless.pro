TARGET = sailvless

CONFIG += sailfishapp sailfishapp_i18n
QT += dbus

isEmpty(VERSION): VERSION = 0.11.2
DEFINES += APP_VERSION=\\\"$$VERSION\\\"

SOURCES += \
    src/main.cpp \
    src/daemon.cpp

HEADERS += \
    src/daemon.h

DISTFILES += \
    qml/*.qml \
    qml/pages/*.qml \
    qml/cover/*.qml \
    qml/js/*.js \
    sailvless.desktop

SAILFISHAPP_ICONS = 86x86 108x108 128x128 172x172

# sailvless.ts holds English plural forms; ru is generated by translations/gen-ts.ps1
TRANSLATIONS += \
    translations/sailvless.ts \
    translations/sailvless-ru.ts
