[Unit]
Description=SailVless TUN helper (system-wide VPN mode)
After=dbus.service network.target

[Service]
Type=dbus
BusName=org.sailvless.Tun
ExecStart=/usr/libexec/sailvless/sailvless-tun-helper
# restore routing even if the helper crashed
ExecStopPost=/usr/libexec/sailvless/sailvless-tun-helper --cleanup
Restart=no

# needs: routes/rules/iptables/TUN (NET_ADMIN, NET_RAW), starting the core as the
# calling user (SETUID/SETGID) and handing it CAP_NET_ADMIN for SO_MARK (SETPCAP),
# and stopping that user-owned process again (KILL: root cannot signal other uids without it)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_CHOWN CAP_KILL
# /dev/net/tun is root:vpn 0660 and the unit has no CAP_DAC_OVERRIDE
SupplementaryGroups=vpn
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RuntimeDirectory=sailvless-tun
RuntimeDirectoryMode=0711
ReadWritePaths=/run

[Install]
# started on demand via D-Bus activation
